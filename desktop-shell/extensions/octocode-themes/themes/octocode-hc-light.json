	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#78888a",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"string.quoted",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#258f88"
			}
		},
		{
			"name": "Number / Constant",
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character"
			],
			"settings": {
				"foreground": "#d33682"
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"keyword.control"
			],
			"settings": {
				"foreground": "#7a8c00"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator",
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#7a8c00"
			}
		},
		{
			"name": "Function",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#268bd2"
			}
		},
		{
			"name": "Type / Class",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#a37c00"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"support.variable"
			],
			"settings": {
				"foreground": "#268bd2"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#7a8c00"
			}
		},
		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#a37c00"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#dc322f"
			}
		}
	]
}
