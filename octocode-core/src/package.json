{
	"name": "octocode",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"publisher": "OctoCode",
	"version": "0.1.7",
	"icon": "assets/icons/icon.png",
	"galleryBanner": {
		"color": "#617A91",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.100.0",
		"node": "24.20.0"
	},
	"author": {
		"name": "OctoCode"
	},
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"cline",
		"claude",
		"dev",
		"mcp",
		"openrouter",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama",
		"OctoCode",
		"octocode"
	],
	"activationEvents": [
		"*",
		"onLanguage",
		"onStartupFinished",
		"onWebviewPanel:octocode.TabPanelProvider",
		"onWebviewPanel:octocode.TabPanelProvider.artifacts"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"configurationDefaults": {
			"window.autoDetectColorScheme": true,
			"workbench.preferredLightColorTheme": "Default Light Modern",
			"workbench.preferredDarkColorTheme": "Default Dark Modern"
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "octocode-ActivityBar",
					"title": "%views.activitybar.title%",
					"icon": "assets/icons/icon.png"
				},
				{
					"id": "octocode-mcp-ActivityBar",
					"title": "%views.mcpServices.title%",
					"icon": "assets/icons/activity/mcp-services.svg"
				},
				{
					"id": "octocode-skills-ActivityBar",
					"title": "%views.skills.title%",
					"icon": "assets/icons/activity/skills.svg"
				},
				{
					"id": "octocode-agentmods-ActivityBar",
					"title": "%views.agentMods.title%",
					"icon": "assets/icons/activity/agentmods.svg"
				}
			]
		},
		"views": {
			"octocode-ActivityBar": [
				{
					"type": "webview",
					"id": "octocode.SidebarProvider",
					"name": "%views.sidebar.name%"
				}
			],
			"octocode-mcp-ActivityBar": [
				{
					"id": "octocode.mcpServicesView",
					"name": "%views.mcpServices.title%"
				}
			],
			"octocode-skills-ActivityBar": [
				{
					"id": "octocode.skillsView",
					"name": "%views.skills.title%"
				}
			],
			"octocode-agentmods-ActivityBar": [
				{
					"id": "octocode.agentModsView",
					"name": "%views.agentMods.title%"
				}
			]
		},
		"commands": [
			{
				"command": "octocode.plusButtonClicked",
				"title": "%command.newTask.title%",
				"icon": "$(edit)"
			},
			{
				"command": "octocode.settingsButtonClicked",
				"title": "%command.settings.title%",
				"icon": "$(settings-gear)"
			},
			{
				"command": "octocode.checkForUpdate",
				"title": "%command.checkForUpdate.title%",
				"icon": "$(cloud-download)"
			},
			{
				"command": "octocode.openInNewTab",
				"title": "%command.openInNewTab.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "octocode.openChatPanel",
				"title": "%command.openChatPanel.title%",
				"category": "%configuration.title%",
				"icon": "$(add)"
			},
			{
				"command": "octocode.openArtifactPanel",
				"title": "%command.openArtifactPanel.title%",
				"category": "%configuration.title%",
				"icon": "$(add)"
			},
			{
				"command": "octocode.openBrowserPanel",
				"title": "%command.openBrowserPanel.title%",
				"category": "%configuration.title%",
				"icon": "$(globe)"
			},
			{
				"command": "octocode.openRuntimeTerminal",
				"title": "%command.openRuntimeTerminal.title%",
				"category": "%configuration.title%",
				"icon": "$(add)"
			},
			{
				"command": "octocode.restoreWorkbenchLayout",
				"title": "%command.restoreWorkbenchLayout.title%",
				"category": "%configuration.title%",
				"icon": "$(layout)"
			},
			{
				"command": "octocode.explainCode",
				"title": "%command.explainCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "octocode.fixCode",
				"title": "%command.fixCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "octocode.improveCode",
				"title": "%command.improveCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "octocode.addToContext",
				"title": "%command.addToContext.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "octocode.newTask",
				"title": "%command.newTask.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "octocode.terminalAddToContext",
				"title": "%command.terminal.addToContext.title%",
				"category": "Terminal"
			},
			{
				"command": "octocode.terminalFixCommand",
				"title": "%command.terminal.fixCommand.title%",
				"category": "Terminal"
			},
			{
				"command": "octocode.terminalExplainCommand",
				"title": "%command.terminal.explainCommand.title%",
				"category": "Terminal"
			},
			{
				"command": "octocode.setCustomStoragePath",
				"title": "%command.setCustomStoragePath.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "octocode.importSettings",
				"title": "%command.importSettings.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "octocode.focusInput",
				"title": "%command.focusInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "octocode.acceptInput",
				"title": "%command.acceptInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "octocode.showRipgrepDiagnostic",
				"title": "%command.showRipgrepDiagnostic.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "octocode.toggleAutoApprove",
				"title": "%command.toggleAutoApprove.title%",
				"category": "%configuration.title%"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "octocode.openBrowserPanel",
					"when": "activeWebviewPanelId == 'octocode.TabPanelProvider.artifacts'",
					"group": "navigation@2"
				}
			],
			"editor/context": [
				{
					"submenu": "octocode.contextMenu",
					"group": "1"
				}
			],
			"octocode.contextMenu": [
				{
					"command": "octocode.addToContext",
					"group": "1_actions@1"
				},
				{
					"command": "octocode.explainCode",
					"group": "1_actions@2"
				},
				{
					"command": "octocode.improveCode",
					"group": "1_actions@3"
				}
			],
			"terminal/context": [
				{
					"submenu": "octocode.terminalMenu",
					"group": "2"
				}
			],
			"octocode.terminalMenu": [
				{
					"command": "octocode.terminalAddToContext",
					"group": "1_actions@1"
				},
				{
					"command": "octocode.terminalFixCommand",
					"group": "1_actions@2"
				},
				{
					"command": "octocode.terminalExplainCommand",
					"group": "1_actions@3"
				}
			]
		},
		"keybindings": [
			{
				"command": "octocode.addToContext",
				"key": "cmd+k cmd+a",
				"mac": "cmd+k cmd+a",
				"win": "ctrl+k ctrl+a",
				"linux": "ctrl+k ctrl+a",
				"when": "editorTextFocus && editorHasSelection"
			},
			{
				"command": "octocode.toggleAutoApprove",
				"key": "cmd+alt+a",
				"mac": "cmd+alt+a",
				"win": "ctrl+alt+a",
				"linux": "ctrl+alt+a"
			},
			{
				"command": "octocode.restoreWorkbenchLayout",
				"key": "ctrl+alt+i",
				"mac": "cmd+ctrl+i",
				"win": "ctrl+alt+i",
				"linux": "ctrl+alt+i"
			}
		],
		"submenus": [
			{
				"id": "octocode.contextMenu",
				"label": "%views.contextMenu.label%"
			},
			{
				"id": "octocode.terminalMenu",
				"label": "%views.terminalMenu.label%"
			}
		],
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"octocode.allowedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"git log",
						"git diff",
						"git show"
					],
					"description": "%commands.allowedCommands.description%"
				},
				"octocode.deniedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%commands.deniedCommands.description%"
				},
				"octocode.commandExecutionTimeout": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 600,
					"description": "%commands.commandExecutionTimeout.description%"
				},
				"octocode.commandTimeoutAllowlist": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%commands.commandTimeoutAllowlist.description%"
				},
				"octocode.execution.environment": {
					"type": "string",
					"enum": [
						"auto",
						"vscode-terminal",
						"pwsh",
						"wsl",
						"msvc",
						"docker",
						"android",
						"macos-remote"
					],
					"default": "auto",
					"scope": "machine",
					"description": "%settings.execution.environment.description%"
				},
				"octocode.agent.fallbackProfiles": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%settings.agent.fallbackProfiles.description%"
				},
				"octocode.agent.askUserTimeoutSeconds": {
					"type": "number",
					"default": 180,
					"minimum": 0,
					"description": "%settings.agent.askUserTimeoutSeconds.description%"
				},
				"octocode.agent.review": {
					"type": "boolean",
					"default": true,
					"description": "%settings.agent.review.description%"
				},
				"octocode.agent.streamRules": {
					"type": "array",
					"default": [],
					"items": {
						"type": "object",
						"required": [
							"id",
							"scope",
							"pattern",
							"message"
						],
						"properties": {
							"id": {
								"type": "string"
							},
							"scope": {
								"type": "string",
								"enum": [
									"text",
									"tool_input"
								]
							},
							"pattern": {
								"type": "string"
							},
							"message": {
								"type": "string"
							}
						}
					},
					"description": "%settings.agent.streamRules.description%"
				},
				"octocode.execution.wslDistribution": {
					"type": "string",
					"default": "OctoCode",
					"scope": "machine",
					"description": "%settings.execution.wslDistribution.description%"
				},
				"octocode.execution.dockerContext": {
					"type": "string",
					"default": "default",
					"scope": "machine",
					"description": "%settings.execution.dockerContext.description%"
				},
				"octocode.execution.msvcDevCmd": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"description": "%settings.execution.msvcDevCmd.description%"
				},
				"octocode.execution.macosRemoteHost": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"description": "%settings.execution.macosRemoteHost.description%"
				},
				"octocode.preventCompletionWithOpenTodos": {
					"type": "boolean",
					"default": false,
					"description": "%commands.preventCompletionWithOpenTodos.description%"
				},
				"octocode.vsCodeLmModelSelector": {
					"type": "object",
					"properties": {
						"vendor": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.vendor.description%"
						},
						"family": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.family.description%"
						}
					},
					"description": "%settings.vsCodeLmModelSelector.description%"
				},
				"octocode.customStoragePath": {
					"type": "string",
					"default": "",
					"description": "%settings.customStoragePath.description%"
				},
				"octocode.enableCodeActions": {
					"type": "boolean",
					"default": true,
					"description": "%settings.enableCodeActions.description%"
				},
				"octocode.autoImportSettingsPath": {
					"type": "string",
					"default": "",
					"description": "%settings.autoImportSettingsPath.description%"
				},
				"octocode.maximumIndexedFilesForFileSearch": {
					"type": "number",
					"default": 10000,
					"minimum": 5000,
					"maximum": 500000,
					"description": "%settings.maximumIndexedFilesForFileSearch.description%"
				},
				"octocode.useAgentRules": {
					"type": "boolean",
					"default": true,
					"description": "%settings.useAgentRules.description%"
				},
				"octocode.apiRequestTimeout": {
					"type": "integer",
					"default": 600,
					"minimum": 1,
					"maximum": 3600,
					"description": "%settings.apiRequestTimeout.description%"
				},
				"octocode.newTaskRequireTodos": {
					"type": "boolean",
					"default": false,
					"description": "%settings.newTaskRequireTodos.description%"
				},
				"octocode.codeIndex.embeddingBatchSize": {
					"type": "number",
					"default": 60,
					"minimum": 1,
					"maximum": 200,
					"description": "%settings.codeIndex.embeddingBatchSize.description%"
				},
				"octocode.debug": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debug.description%"
				},
				"octocode.debugProxy.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debugProxy.enabled.description%",
					"markdownDescription": "%settings.debugProxy.enabled.description%"
				},
				"octocode.debugProxy.serverUrl": {
					"type": "string",
					"default": "http://127.0.0.1:8888",
					"description": "%settings.debugProxy.serverUrl.description%",
					"markdownDescription": "%settings.debugProxy.serverUrl.description%"
				},
				"octocode.debugProxy.tlsInsecure": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debugProxy.tlsInsecure.description%",
					"markdownDescription": "%settings.debugProxy.tlsInsecure.description%"
				},
				"octocode.workspace.path": {
					"type": "string",
					"default": "",
					"scope": "application",
					"markdownDescription": "OctoCode 工作区的唯一配置路径。填写绝对路径；留空使用安装目录下的 workspace。修改后重新打开工作区，agent、终端及文件工具统一使用该路径。"
				},
				"octocode.workspace.rootResolution": {
					"deprecationMessage": "Workspace now uses octocode.workspace.path exclusively.",
					"type": "string",
					"enum": [
						"activeEditor",
						"firstFolder"
					],
					"enumDescriptions": [
						"%settings.workspace.rootResolution.activeEditor.description%",
						"%settings.workspace.rootResolution.firstFolder.description%"
					],
					"default": "activeEditor",
					"scope": "machine",
					"description": "%settings.workspace.rootResolution.description%",
					"markdownDescription": "%settings.workspace.rootResolution.description%"
				},
				"octocode.update.manifestUrl": {
					"type": "string",
					"default": "",
					"markdownDescription": "%configuration.update.manifestUrl.description%"
				},
				"octocode.update.mode": {
					"type": "string",
					"enum": [
						"manual",
						"start"
					],
					"default": "manual",
					"enumDescriptions": [
						"%configuration.update.mode.manual%",
						"%configuration.update.mode.start%"
					],
					"markdownDescription": "%configuration.update.mode.description%"
				}
			}
		}
	},
	"scripts": {
		"lint": "eslint . --ext=ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"bundle": "node esbuild.mjs",
		"vsix": "node ../scripts/stage-host.mjs && pnpm --dir ../webview-ui build && pnpm bundle --production && mkdirp ../bin && vsce package --no-dependencies --allow-missing-repository --allow-star-activation --out ../bin",
		"publish:vsce": "npx @vscode/vsce publish --packagePath ../bin/octocode-$npm_package_version.vsix",
		"publish:ovsx": "pnpm exec ovsx publish ../bin/octocode-$npm_package_version.vsix --skip-duplicate",
		"publish:marketplace": "pnpm vsix && pnpm publish:vsce && pnpm publish:ovsx",
		"watch:bundle": "pnpm bundle --watch",
		"watch:tsc": "cd .. && tsc --noEmit --watch --project src/tsconfig.json",
		"clean": "rimraf README.md CHANGELOG.md LICENSE dist logs mock .turbo"
	},
	"dependencies": {
		"@octocode/sdk": "npm:@anthropic-ai/sdk@^0.120.0",
		"@anthropic-ai/vertex-sdk": "^0.19.5",
		"@aws-sdk/client-bedrock-runtime": "^3.922.0",
		"@aws-sdk/credential-providers": "^3.922.0",
		"@google/genai": "^2.18.0",
		"@lmstudio/sdk": "^1.1.1",
		"@mistralai/mistralai": "^1.9.18",
		"@modelcontextprotocol/sdk": "1.29.0",
		"@qdrant/js-client-rest": "^1.14.0",
		"@roo-code/cloud": "workspace:^",
		"@roo-code/core": "workspace:^",
		"@roo-code/ipc": "workspace:^",
		"@roo-code/telemetry": "workspace:^",
		"@roo-code/types": "workspace:^",
		"@smithy/node-http-handler": "^4.0.0",
		"ai-sdk-provider-poe": "2.0.18",
		"async-mutex": "^0.5.0",
		"axios": "^1.18.1",
		"chokidar": "^4.0.1",
		"clone-deep": "^4.0.1",
		"delay": "^6.0.0",
		"diff": "^5.2.0",
		"dotenv": "^17.4.2",
		"exceljs": "^4.4.0",
		"fast-deep-equal": "^3.1.3",
		"fastest-levenshtein": "^1.0.16",
		"fzf": "^0.5.2",
		"get-folder-size": "^5.0.0",
		"global-agent": "^4.1.3",
		"google-auth-library": "^10.2.0",
		"gray-matter": "^4.0.3",
		"http-proxy-agent": "^7.0.0",
		"https-proxy-agent": "^7.0.0",
		"i18next": "26.4.0",
		"ignore": "^7.0.3",
		"isbinaryfile": "^5.0.7",
		"json-stream-stringify": "^3.1.7",
		"jszip": "^3.10.1",
		"lodash.debounce": "^4.0.8",
		"mammoth": "^1.12.1",
		"monaco-vscode-textmate-theme-converter": "^0.1.7",
		"node-cache": "^5.1.2",
		"ollama": "^0.6.0",
		"openai": "^5.12.2",
		"os-name": "^6.0.0",
		"p-limit": "^6.2.0",
		"p-wait-for": "^5.0.2",
		"partial-json": "^0.1.7",
		"pdf-parse": "^1.1.1",
		"pretty-bytes": "^7.0.0",
		"proper-lockfile": "^4.1.2",
		"ps-tree": "^1.2.0",
		"reconnecting-eventsource": "^1.6.5",
		"safe-stable-stringify": "^2.5.0",
		"sanitize-filename": "^1.6.4",
		"say": "^0.16.0",
		"semver-compare": "^1.0.0",
		"serialize-error": "^12.0.0",
		"shell-quote": "^1.8.2",
		"simple-git": "^3.27.0",
		"strip-bom": "^5.0.0",
		"tiktoken": "^1.0.21",
		"tree-sitter-wasms": "^0.1.13",
		"undici": "^6.21.3",
		"uuid": "^11.1.0",
		"web-tree-sitter": "^0.25.6",
		"workerpool": "^9.2.0",
		"yaml": "^2.8.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@ai-sdk/openai-compatible": "2.0.56",
		"@roo-code/build": "workspace:^",
		"@roo-code/config-eslint": "workspace:^",
		"@roo-code/config-typescript": "workspace:^",
		"@types/clone-deep": "4.0.4",
		"@types/diff": "5.2.3",
		"@types/lodash.debounce": "4.0.9",
		"@types/node": "24.13.3",
		"@types/proper-lockfile": "4.1.4",
		"@types/ps-tree": "1.1.6",
		"@types/semver-compare": "1.0.3",
		"@types/vscode": "1.100.0",
		"@vitest/coverage-v8": "4.1.9",
		"@vscode/vsce": "3.9.2",
		"ai": "6.0.218",
		"esbuild-wasm": "0.28.1",
		"execa": "9.6.1",
		"mkdirp": "3.0.1",
		"nock": "14.0.15",
		"ovsx": "1.1.1",
		"rimraf": "6.0.1",
		"vitest": "4.1.11"
	}
}
