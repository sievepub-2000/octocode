!/work/windows-linker.toml
!/work/windows-harness-linker.toml
!/maintenance/
!/octocode-core/
!/desktop-shell/
!/octo-harness/
__pycache__/
!/docs/
/docs/*
!/docs/releases/
/docs/releases/*
!/docs/releases/0.1.8.md
!/docs/releases/0.1.9.md
!/docs/superpowers/
!/docs/HARNESS2.md
!/docs/USER_GUIDE.zh-CN.md
