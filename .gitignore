# Version orchestration, maintenance and reports; the three source trees have their own repositories.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/*.ps1
!/WINDOWS-INSTALL-UPDATE.md
!/reports/
!/work/
/work/*
!/work/octo-env.ps1
!/maintenance/
__pycache__/
!/docs/
/docs/*
!/docs/releases/
/docs/releases/*
!/docs/releases/0.1.8.md

# Aggregate GitHub source trees
!/desktop-shell/
!/octocode-core/
!/octo-harness/
